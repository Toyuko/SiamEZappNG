# Copy to .env for local development — never commit .env (secrets / overrides stay local).

# Production API / website (canonical host — same origin as SiamEZwebNG)
EXPO_PUBLIC_API_URL=https://siam-ez.com
EXPO_PUBLIC_WEB_BASE_URL=https://siam-ez.com

# Soft-launch tab IA: Services / Vehicles / RE / Concierge / More (set to "false" to disable)
# EXPO_PUBLIC_SOFT_LAUNCH=false

# Booking uses the standard website flow (POST /api/bookings) — no extra flag needed.
# Guest checkout URL (must match SiamEZwebNG):
#   {EXPO_PUBLIC_WEB_BASE_URL}/checkout/{caseId}?token={guestCheckoutToken}

# Pusher (job board real-time feed — same keys as SiamEZwebNG NEXT_PUBLIC_PUSHER_*)
EXPO_PUBLIC_PUSHER_KEY=
EXPO_PUBLIC_PUSHER_CLUSTER=

# Local Next.js backend from Android emulator (host machine localhost)
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Force offline mock data (dev / unit tests only). Release builds ignore these
# unless EXPO_PUBLIC_ALLOW_MOCKS=true (never set that for store builds).
# EXPO_PUBLIC_FREELANCER_MOCK=true
# EXPO_PUBLIC_CORPORATE_MOCK=true
# EXPO_PUBLIC_ALLOW_MOCKS=true
